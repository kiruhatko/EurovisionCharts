# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
DB_USERNAME=eurofans_app
DB_PASSWORD=

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Deployment binding (see scripts/generate-binding.sh) --------------------
# Set to false ONLY for a single-user personal deployment with no group lock.
DEPLOYMENT_BINDING_ENABLED=true
AUTHORIZED_GROUP_CHAT_ID=
DEPLOYMENT_BINDING_FILE=file:/run/secrets/deployment-binding.json
DEPLOYMENT_BINDING_PUBLIC_KEY=

# --- Admin ----------------------------------------------------------------
# Comma-separated numeric Telegram user IDs. Never a username.
ADMIN_TELEGRAM_IDS=

# --- Token encryption (base64, 32 raw bytes, e.g. `openssl rand -base64 32`) -
TOKEN_ENCRYPTION_KEY=

# --- Public HTTPS domain, required for OAuth callbacks and the Apple Music
#     MusicKit connect page (no trailing slash) -----------------------------
PUBLIC_BASE_URL=

# --- Spotify ------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=${PUBLIC_BASE_URL}/oauth/spotify/callback

# --- Apple Music (MusicKit) -----------------------------------------------
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Contents of the .p8 private key file from the Apple Developer portal.
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_REDIRECT_ORIGIN=${PUBLIC_BASE_URL}

# --- SoundCloud -----------------------------------------------------------
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=${PUBLIC_BASE_URL}/oauth/soundcloud/callback

# --- Last.fm (free API key, no OAuth) --------------------------------------
LASTFM_API_KEY=
